#!/system/bin/sh

dir="${0%/*}"
tmpDaemonApk="/data/local/tmp/daemon.apk"
debug="@DEBUG@"

# Safely check for debug APK and set classpath
if [ -r "$tmpDaemonApk" ]; then
  java_options="-Djava.class.path=$tmpDaemonApk"
  debug="true"
else
  java_options="-Djava.class.path=$dir/daemon.apk"
fi

# Apply debug options based on Android SDK version.
# Reference: https://developer.android.com/ndk/guides/wrap-script#debugging_when_using_wrapsh
if [ "$debug" = "true" ]; then
  os_version=$(getprop ro.build.version.sdk)
  if [ "$os_version" -eq "27" ]; then
    java_options="$java_options -Xrunjdwp:transport=dt_android_adb,suspend=n,server=y -Xcompiler-option --debuggable"
  elif [ "$os_version" -eq "28" ]; then
    java_options="$java_options -XjdwpProvider:adbconnection -XjdwpOptions:suspend=n,server=y -Xcompiler-option --debuggable"
  else
    java_options="$java_options -XjdwpProvider:adbconnection -XjdwpOptions:suspend=n,server=y"
  fi
fi

# Shadow /data/resource-cache with an empty directory of our own: initializing the framework assets
# in a root app_process forks `idmap2 create-multiple`, which would otherwise write the immutable
# framework idmaps of this boot into the cache every other process shares. Bind an empty directory
# rather than a tmpfs: a bind mount reuses the superblock of /data, so it claims none of the
# kernel-global anonymous device minors, whose gaps are visible from any process on the device.
# Note that this script runs inside an isolated mount namespace (via unshare).
emptyDir="$dir/.resource-cache"
rm -rf "$emptyDir"
mkdir -p "$emptyDir"
mount -o bind "$emptyDir" /data/resource-cache

# Wait for Zygote socket using a polling loop
if [ ! -S "/dev/socket/zygote" ]; then
  # Wait up to ~10 seconds to avoid an infinite hang if something breaks
  wait_count=0
  while [ ! -S "/dev/socket/zygote" ] &&[ "$wait_count" -lt 100 ]; do
    sleep 0.1
    wait_count=$((wait_count + 1))
  done
  [ "$debug" = "true" ] && log -p v -t "Vector" "zygote started"
fi

[ "$debug" = "true" ] && log -p d -t "Vector" "Starting daemon $*"

# Where a start that dies on the way up leaves a word. The daemon opens its own log only after
# main has begun, so a classpath the runtime refuses, a crash in main, or a start that ends before
# main used to arrive at /dev/null and nothing else: the boot then simply had no daemon and no way
# to say why. The file sits in the daemon's own log directory, which the next boot rotates with the
# rest of it.
logDir="/data/adb/lspd/log"
bootstrapLog="$logDir/bootstrap.log"
mkdir -p "$logDir" 2>/dev/null
# In a subshell, so an unwritable path costs the log and not the daemon: a redirection that fails
# on the launch below would end the script before app_process starts.
( : >>"$bootstrapLog" ) 2>/dev/null || bootstrapLog=/dev/null

# Launch the daemon, and keep this shell as its parent. exec would hand the script's PID and its
# exit status to app_process, and the starts worth explaining are the ones that end before main
# writes a line: they leave no stderr, only a status the exec would carry away. The parent waits
# while the daemon runs, writes the status down, and exits with it — one small process, not a
# second daemon.
/system/bin/app_process $java_options /system/bin --nice-name=vectord org.matrix.vector.daemon.VectorDaemon "$@" >/dev/null 2>>"$bootstrapLog"
status=$?
echo "vectord exited with code $status" >>"$bootstrapLog" 2>/dev/null
exit $status
