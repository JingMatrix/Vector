<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the Logs screen.

  Kept in their own file rather than merged into strings.xml: Android merges every values/
  file at build time, so a screen under active development can own its keys without colliding
  with anyone else's edits. Nothing user-visible may be hard-coded in a composable.
-->
<resources>
    <string name="logs_title">ログ</string>
    <!-- Top bar actions -->
    <string name="logs_word_wrap">長い行を折り返す</string>
    <string name="logs_save">バグレポートを保存します…</string>
    <string name="logs_rotate">新しいログを開始します…</string>
    <!-- Search and filter -->
    <string name="logs_search_hint">このログを検索</string>
    <string name="logs_filter">レベルとタグでフィルタリング</string>
    <string name="logs_filter_levels">レベル</string>
    <string name="logs_filter_tags">タグ</string>
    <string name="logs_filter_clear">フィルターをクリア</string>
    <string name="logs_filter_scanning">画面に表示されている範囲を超えてフィルターが内容を認識できるよう、ファイル全体を読み込みます。</string>
    <!-- Level names, used by the filter chips and by TalkBack on each row -->
    <string name="logs_level_verbose">詳細</string>
    <string name="logs_level_debug">デバッグ</string>
    <string name="logs_level_info">情報</string>
    <string name="logs_level_warn">警告</string>
    <string name="logs_level_error">エラー</string>
    <string name="logs_level_fatal">致命的</string>
    <string name="logs_level_other">その他</string>
    <!-- The counter under the search field -->
    <!-- Example: "lines 1 200–3 200 of 30 412" -->
    <string name="logs_window">全 %3$d 行中、%1$d ~ %2$d 行</string>
    <plurals name="logs_matches">
        <item quantity="other">一致する行: %1$d 行</item>
    </plurals>
    <string name="logs_dropped">このログはビューアーのインデックスよりも長くなっています。最も古い %1$d 行は表示されません。それらを保持するには、バグレポートを保存してください。</string>
    <string name="logs_line_truncated">行を省略</string>
    <plurals name="logs_frames">
        <item quantity="other">%1$d フレーム</item>
    </plurals>
    <!-- The four distinct nothing-to-show states -->
    <string name="logs_state_daemon_title">デーモンに接続できません</string>
    <string name="logs_state_daemon_body">Vector が起動するまで、ログの状態は確認できません。[ホーム] のステータスリボンが緑色でないのも同じ理由です。</string>
    <string name="logs_state_nofile_title">ログファイルはまだありません</string>
    <string name="logs_state_nofile_body">デーモンは実行されていますが、このログはまだ開かれていません。詳細ログの場合は通常、詳細ログの記録が無効になっています。</string>
    <string name="logs_state_empty_title">このログは空です</string>
    <string name="logs_state_empty_body">ファイルは存在しますが、まだ何も書き込まれていません。モジュールログでは、アクティビティがない (システムが静止) 状態の場合、このように表示されます。</string>
    <string name="logs_state_nomatches_title">一致するログはありません</string>
    <string name="logs_state_nomatches_body">ファイルにはログがありますが、現在のフィルターによってすべて除外されています。</string>
    <string name="logs_state_failed_title">ログを読み込めませんでした</string>
    <string name="logs_state_failed_body">デーモンから渡されたファイルを読み込めませんでした: %1$s</string>
    <string name="logs_loading">ログを読み込んでいます…</string>
    <!-- Verbose logging -->
    <string name="logs_verbose_switch">詳細ログ</string>
    <string name="logs_verbose_enforced">実行中のデーモンにより、この設定は強制的に有効になっています。</string>
    <!-- Navigation within a long log -->
    <string name="logs_jump_oldest">最も古い行へ移動</string>
    <string name="logs_jump_newest">最も新しい行へ移動</string>
    <!-- Per-row actions -->
    <string name="logs_row_detail">UID %1$d・PID %2$d・TID %3$d</string>
    <!-- Starting a new log: the consequence, named -->
    <string name="logs_rotate_title">新しいログを開始しますか？</string>
    <string name="logs_rotate_body">何も削除されません。デーモンは現在のログを閉じて、新しいログへの記録を開始します。閉じられたログは、直近 10 件から外れるまで端末に残り、スワイプして確認できます。また、保存されたバグレポートにも引き続き含まれます。</string>
    <string name="logs_rotate_confirm">新しいログを開始します</string>
    <string name="logs_rotate_done">新しいログが開始されました</string>
    <string name="logs_rotate_failed">デーモンが新しいログの開始を拒否しました</string>
    <string name="logs_cancel">キャンセル</string>
    <!-- Saving -->
    <string name="logs_save_name">vector-logs-%1$s.zip</string>
    <string name="logs_saving">ログ、クラッシュダンプ、dmesg を収集しています…</string>
    <string name="logs_saved">バグレポートが保存されました</string>
    <string name="logs_save_failed">バグレポートを保存できませんでした</string>
    <string name="logs_save_failed_reason">バグレポートを保存できませんでした: %1$s</string>
    <string name="logs_share">共有</string>
    <string name="logs_filter_clear_tag">タグフィルターを解除</string>
    <string name="logs_settings">ログの設定</string>
    <string name="logs_source_more">フレームワークのログも含める</string>
    <string name="logs_source_less">モジュールのログのみ表示</string>
    <string name="logs_verbose_summary">バグを報告する前に、これを有効にしてください。アプリは自身のログを読み取ることができるため、これを有効にしておくと、アプリがVectorを検出する手段の一つとなります。</string>
    <string name="logs_save_summary">両方のログを、指定した zip ファイルに書き出します</string>
    <string name="logs_rotate_summary">現在のログを閉じて、新しいログを開始します</string>
    <string name="logs_part">分割ログ %1$d / %2$d</string>
    <string name="logs_part_older">前の分割ログ</string>
    <string name="logs_part_newer">次の分割ログ</string>
</resources>
