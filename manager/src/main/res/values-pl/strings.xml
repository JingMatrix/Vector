    <!-- Same version number as the newest canary, but built from a different commit -->
    <string name="canary_diverged">Twoja kompilacja ma najnowszy numer Canary, ale nie została zbudowana na jego podstawie. Zainstaluj go, aby mieć pewność, co testujesz.</string>
    <!-- On a release published after the last canary — normal for a day or two after a release -->
    <string name="canary_after_release">Jesteś na wersji nowszej niż wszystkie Canary tutaj. Kolejne Canary zostanie zbudowane na jej podstawie.</string>
